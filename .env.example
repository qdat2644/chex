# ==============================================================================
# CheXpert AI Workstation - Environment Configuration Template
# ==============================================================================

# Application Environment: 'development' or 'production'
# In 'production', PHI_HMAC_SECRET and valid model checkpoints are strictly required.
APP_ENV=production

# Mandatory Secret Key for HMAC-SHA256 Protected Health Information (PHI) Masking
# Must be a high-entropy string of at least 32 characters in production.
# Can also be mounted via Docker Secret at /run/secrets/phi_hmac_secret
PHI_HMAC_SECRET=replace_with_a_secure_random_production_secret_key_at_least_32_characters_long

# Optional API Security: Set an API Key to protect /api/* endpoints
# If set, clients must provide header: 'Authorization: Bearer <key>' or 'X-API-Key: <key>'
# API_KEY=your_secure_random_api_key_here

# Pinned Artifact Checksums (SHA-256)
CHEXPERT_CHECKPOINT_SHA256=b8b1884a911f6ff9408de141c48034a39f4515e2c8deaadd25312e07601c9bc0
CHEXPERT_THRESHOLDS_SHA256=7ad370d14f7941fae476d0f2ba2038fcfeedbbf70dcfd1e45cb083baa28965ea

# Hugging Face Pinned Release Revision (Commit SHA or Tag)
HUGGINGFACE_REVISION=d9b23e7f4c0b6b25ea958d0421295b9c0587b1c3

# Auto Download Flag (set to 'false' in offline or CI environments)
CHEXPERT_AUTO_DOWNLOAD=true

# Model Checkpoint Path
CHEXPERT_CHECKPOINT=checkpoints/chexpert_convnext_small.pt

# Rate Limiting Configuration (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
